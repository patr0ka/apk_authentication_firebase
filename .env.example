# Firebase Android client configuration (copy this file to .env locally).
FIREBASE_API_KEY=replace_with_your_api_key
FIREBASE_APP_ID=replace_with_your_android_app_id
FIREBASE_MESSAGING_SENDER_ID=replace_with_your_project_number
FIREBASE_PROJECT_ID=replace_with_your_project_id
FIREBASE_STORAGE_BUCKET=replace_with_your_storage_bucket
